'		`uvm_info(get_type_name(), ',
'		$sformatf("[NEW]Store SIM RESULT of [%s][%0d(ID)]", ',
'		raw_req.wr_or_rd ? "WRITE" : "READ_", raw_req.id[7:0]), UVM_MEDIUM)',
